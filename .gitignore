# Migration artifacts — contain secrets and PII, do NOT commit
migration/*.sql
migration/parsed.json

# Local tooling
node_modules/
# package-lock.json is COMMITTED (project-review PR#81): without lockfiles
# every CI run re-resolves floating ranges (typescript ^6, electron ^32,
# @playwright/test), so releases weren't reproducible and a dependency
# release could break CI/visual baselines with no code change.

# Capacitor native build artifacts (the ios/ & android/ projects themselves
# may be committed; these generated outputs should not be)
ios/App/Pods/
ios/App/build/
ios/DerivedData/
android/.gradle/
android/build/
android/app/build/
android/app/google-services.json
ios/App/App/GoogleService-Info.plist

# Python solver-service runtime artifacts
solver-service/**/__pycache__/
solver-service/.venv/
solver-service/.pytest_cache/
*.pyc

# Playwright visual-regression artifacts
tests/visual/test-results/
test-results/

# Local secrets — never commit
.env
.env.*
!.env.example

# Booking e2e: locally built supabase-js bundle (rebuilt in CI)
tests/booking-e2e/.supabase-esm.js
