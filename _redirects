# Cloudflare Pages redirects — translated from netlify.toml.
# Format: <from> <to> <status>   (302 = redirect; 301 = permanent.)
#
# IMPORTANT: token short-links MUST use a 3xx redirect, NOT a 200 rewrite.
# Cloudflare Pages does NOT substitute :placeholders into the destination
# of a 200 (proxy) rewrite — it serves the page but drops the token, so
# screening.html sees an empty ?t= and shows "link looks invalid".
# Placeholder substitution only works on redirect status codes, so these
# 302 to the long /dashboard/*.html?...=token form (which the pages read).
# Trade-off: the address bar shows the long URL instead of the short path.

# Short-links for applicant/driver-facing links. The original
# /dashboard/*.html?...=token paths still resolve, so previously
# emailed/SMS'd links keep working.
/s/:token        /dashboard/screening.html?t=:token   302
/q/:token        /dashboard/shop.html?t=:token         302
/b/:token        /dashboard/booking.html?t=:token      302
/c/:token        /dashboard/coaching.html?t=:token     302
/r/:token        /dashboard/refer.html?r=:token        302
/rsvp/:token/:resp /dashboard/rsvp.html?t=:token&r=:resp 302
/rsvp/:token     /dashboard/rsvp.html?t=:token          302

# RouteReady Meet — short invite links. 302 so the ?m= code survives
# placeholder substitution (see note above); meet.js also parses the
# /m/<code> path itself, so either shape works.
/m/:code         /dashboard/meet.html?m=:code           302
/meet            /dashboard/meet.html                   200

# Public document-verification page. /verify/<token> and bare /verify
# both resolve to verify.html (which also reads ?token=).
/verify/:token   /verify.html?token=:token             302
/verify          /verify.html                          200

# Pretty URLs for the download + getting-started pages.
# NOTE: Cloudflare Pages already serves these .html files at their
# extensionless paths (/download, /installed) AND 301s the .html form to
# the clean path. An explicit "/download -> /download.html 200" rewrite
# fights that auto-redirect and causes ERR_TOO_MANY_REDIRECTS, so we rely
# on Cloudflare's native clean URLs here instead of a rewrite rule.

# Old marketing pages consolidated into the landing (permanent).
/about.html          /              301
/how-it-works.html   /#how          301
/privacy-policy.html /privacy.html  301
