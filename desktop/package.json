{
  "name": "routeready-desktop",
  "version": "0.6.12",
  "description": "RouteReady desktop sync · drives the Amazon DSP portal under the operator's corporate login, pulls route data + pick sheets, and ships them to RouteReady.",
  "main": "main.js",
  "private": true,
  "homepage": "https://gorouteready.com",
  "author": {
    "name": "RouteReady",
    "email": "support@gorouteready.com"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.101.0",
    "@supabase/supabase-js": "^2.45.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "playwright": "^1.48.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.routeready.desktop",
    "productName": "RouteReady Desktop",
    "directories": { "output": "dist" },
    "protocols": [
      { "name": "RouteReady", "schemes": ["routeready"] }
    ],
    "publish": [
      { "provider": "github", "owner": "rrhester", "repo": "routeready" }
    ],
    "files": [
      "main.js",
      "preload.js",
      "scraper.js",
      "agent.js",
      "renderer/**/*",
      "build/icon.png",
      "node_modules/**/*",
      "!node_modules/**/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/**/{test,tests,__tests__,examples,docs,.github}/**",
      "!node_modules/**/*.{md,markdown,d.ts,map,test.js,spec.js}"
    ],
    "extraResources": [
      {
        "from": "node_modules/playwright-core/.local-browsers",
        "to": "pw-browsers"
      }
    ],
    "asar": false,
    "mac": {
      "category": "public.app-category.business",
      "target": "dmg",
      "artifactName": "RouteReady-Desktop.${ext}",
      "asar": true,
      "asarUnpack": [
        "node_modules/playwright-core/.local-browsers/**"
      ]
    },
    "win": {
      "target": "nsis",
      "artifactName": "RouteReady-Desktop.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "maintainer": "RouteReady <support@gorouteready.com>",
      "icon": "build/icon.png",
      "artifactName": "RouteReady-Desktop.${ext}"
    }
  }
}
