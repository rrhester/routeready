# Cloudflare Pages headers — translated from netlify.toml.
# Format: a path/pattern line, followed by indented "Name: value" lines.
#
# The dashboard inlines all its CSS inside the HTML, so HTML must never
# be cached; cache-busting rides on the ?v=<commit> tokens on JS/CSS
# (rewritten at build time by scripts/bust-cache.mjs). Service workers
# and manifests are likewise never-cache so a deploy reaches devices on
# the next load.

# Security headers — applied site-wide. These are safe, non-breaking
# hardening headers (no enforcing CSP — see note below). They harden a
# PII-handling operator dashboard against clickjacking, MIME sniffing,
# referrer leakage, and protocol-downgrade attacks.
#   geolocation=(self): the routing app uses navigator.geolocation
#   (dashboard/live.js station-locate, app/app.js), so (self) is the
#   least-breaking Permissions-Policy value.
#   camera/microphone/display-capture=(self): RouteReady Meet
#   (dashboard/meet.html) is a first-party video tool; (self) still
#   denies embedded third-party iframes, and the browser's permission
#   prompt continues to gate actual device access per page.
#   X-Frame-Options SAMEORIGIN (was DENY): the dashboard's interview
#   room embeds our own meet.html in an iframe; SAMEORIGIN still blocks
#   every cross-origin framing attempt.
# CSP: deferred — inline scripts/styles need nonce/hash refactor first.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(self), display-capture=(self), payment=()
  X-XSS-Protection: 0

/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/dashboard/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Directory / clean-path index requests (/, /dashboard/, /app/) don't end in
# .html, so the *.html rules above never match them — CF would then edge-cache
# the app shell and pin operators to a stale ?v= token even across deploys (a
# hard-reload doesn't bypass the edge cache). Force-revalidate the index docs.
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/dashboard/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/app/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/dashboard/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/dashboard/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/manifest+json

/app/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/app/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/manifest+json

# View partials (monolith split phase 2) · immutable — every reference
# carries a deploy-unique ?v= token (bust-cache.mjs), so the content at
# any given URL never changes.
/dashboard/views/*
  Cache-Control: public, max-age=31536000, immutable
