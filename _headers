  Cache-Control: public, max-age=31536000, immutable
/dashboard/workbook.js
  Cache-Control: public, max-age=31536000, immutable
/dashboard/reports.js
  Cache-Control: public, max-age=31536000, immutable
/dashboard/meet.js
  Cache-Control: public, max-age=31536000, immutable
/dashboard/meet-core.js
  Cache-Control: public, max-age=31536000, immutable
/dashboard/scheduling-engine.js
  Cache-Control: public, max-age=31536000, immutable
/dashboard/mock-wiring.js
