#!/usr/bin/env bash
# RouteReady pre-push gate.  Runs the smoke-check so a busted live.js
# (orphan top-level code, parse error, conflict marker) can never reach
# the remote, plus changed-file-aware fast checks so the common CI
# failures surface here (~seconds) instead of ~5 minutes post-push.
#
# Bypassing this hook (--no-verify) is forbidden — every reach for
# --no-verify in the past has resulted in production going dark.

set -e

# If acorn isn't installed yet, bail with a clear message instead of an
# obscure ERR_MODULE_NOT_FOUND.
if [ ! -d node_modules/acorn ]; then
  echo "✗ pre-push: node_modules/acorn missing.  Run \`npm install\` first." >&2
  exit 1
fi

node scripts/smoke-check-live.mjs

# Changed files vs what the remote already has. @{push} needs an upstream;
# fall back to origin/main, then to "check everything".
changed=$(git diff --name-only '@{push}...HEAD' 2>/dev/null \
       || git diff --name-only origin/main...HEAD 2>/dev/null \
       || echo ALL)

if echo "$changed" | grep -qE '^(scripts/|dashboard/(workbook\.js|cal-tz\.mjs|ivcal-|forecast-core\.js|meet-core\.js|parts/)|app/(app\.js|form-validation\.js)|tests/fixtures/|ALL$)'; then
  echo "→ pre-push: unit-tested sources changed — running npm test"
  npm test
fi

if echo "$changed" | grep -qE '^(app/(app\.js|comms-native\.js|styles\.css|rr-system\.css|form-validation\.js|sw\.js)|ALL$)'; then
  echo "→ pre-push: PWA shell asset changed — checking SHELL_CACHE bump"
  CACHE_CHECK_BASE=origin/main node scripts/check-cache-bump.mjs || {
    echo "  (bump SHELL_CACHE in app/sw.js so installed PWAs pick up the change)" >&2
    exit 1
  }
fi

if echo "$changed" | grep -qE '^supabase/migrations/|^ALL$'; then
  echo "→ pre-push: migrations changed — checking ordinals"
  node scripts/check-migration-ordinals.mjs
fi
