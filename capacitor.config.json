{
  "appId": "com.gorouteready.driver",
  "appName": "RouteReady",
  "webDir": "app",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#ffffff"
  },
  "android": {
    "backgroundColor": "#ffffff"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "backgroundColor": "#ffffff",
      "showSpinner": false,
      "launchAutoHide": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#ffffff"
    }
  }
}
